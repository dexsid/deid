# Copy to .env.local, which is excluded from Git.
# Set a unique random secret of at least 32 characters before enabling owner login.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
DATABASE_PATH=.data/deid.sqlite

# Used only by npm run owner:create; remove the password after creating the owner.
DEID_OWNER_EMAIL=
DEID_OWNER_PASSWORD=
DEID_OWNER_NAME=
